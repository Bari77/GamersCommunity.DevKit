{
  "name": "@bari77/gc-workspace-editor",
  "version": "0.8.12",
  "description": "CLI and standalone editor for default player workspace layouts in GamersCommunity game fronts",
  "type": "module",
  "bin": {
    "gc-workspace": "bin/gc-workspace.mjs"
  },
  "files": [
    "bin",
    "dist",
    "editor"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:editor": "vite build --config editor/vite.config.mts"
  },
  "dependencies": {
    "@analogjs/vite-plugin-angular": "2.7.2",
    "@angular/animations": "21.2.17",
    "@angular/build": "21.2.15",
    "@angular/cli": "21.2.15",
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/compiler-cli": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/localize": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/platform-browser-dynamic": "21.2.17",
    "@bari77/gc-theme": "0.8.2",
    "angular-gridster2": "21.0.1",
    "esbuild": "^0.25.12",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "vite": "^6.4.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "@bari77/gc-widgets": "^0.8.0"
  },
  "overrides": {
    "@angular/build": "21.2.15"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bari77/GamersCommunity.DevKit.git"
  },
  "license": "UNLICENSED"
}
