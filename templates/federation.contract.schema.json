{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamerscommunity.local/schemas/federation.contract.schema.json",
  "title": "FederationContract",
  "description": "Module Federation contract exposed by a game remote to the Front shell.",
  "type": "object",
  "additionalProperties": false,
  "required": ["remoteName", "expose", "routePrefix", "remoteEntryDev"],
  "properties": {
    "remoteName": {
      "type": "string",
      "minLength": 1,
      "description": "Federation remote name (e.g. worldofwarcraft)."
    },
    "expose": {
      "type": "string",
      "minLength": 1,
      "description": "Exposed module path (e.g. ./Routes)."
    },
    "routePrefix": {
      "type": "string",
      "minLength": 1,
      "description": "Shell route prefix for this game (e.g. /wow)."
    },
    "remoteEntryDev": {
      "type": "string",
      "minLength": 1,
      "description": "Dev remoteEntry URL (e.g. http://localhost:4201/remoteEntry.json)."
    },
    "resources": {
      "type": "array",
      "description": "Gateway resources declared for this game (optional).",
      "items": {
        "$ref": "#/$defs/gatewayResource"
      }
    }
  },
  "$defs": {
    "gatewayResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["DATA", "APP", "INFRA"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
